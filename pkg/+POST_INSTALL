#!/bin/sh
# post-install for pfSense-pkg-amneziawg (pkg create +POST_INSTALL)
set -e
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
export PATH

mkdir -p /usr/local/etc/amneziawg /var/run/amneziawg
if [ ! -f /usr/local/etc/amneziawg/enabled ]; then
	echo "0" > /usr/local/etc/amneziawg/enabled
fi
chmod 0750 /usr/local/etc/amneziawg 2>/dev/null || true

if [ -f /usr/local/etc/rc.d/amneziawg ]; then
	chmod 0555 /usr/local/etc/rc.d/amneziawg
fi

if [ -x /usr/sbin/sysrc ]; then
	/usr/sbin/sysrc amneziawg_enable=YES >/dev/null 2>&1 || true
fi

# Register in config.xml / VPN menu (pkg add alone does not — same as GUI installer).
REG=/usr/local/share/pfSense-pkg-amneziawg/amneziawg_register.php
if [ -f "$REG" ]; then
	chmod 0555 "$REG" 2>/dev/null || true
	reg_ok=0
	if [ -x /usr/local/sbin/fcgicli ] && /usr/local/sbin/fcgicli -f "$REG"; then
		reg_ok=1
	elif /usr/local/bin/php -f "$REG"; then
		reg_ok=1
	fi
	if [ "$reg_ok" != 1 ]; then
		echo "pfSense-pkg-amneziawg: WARNING: GUI registration failed. Run: /usr/local/bin/php -f $REG" >&2
	fi
fi

echo "pfSense-pkg-amneziawg: installed. Open VPN > AmneziaWG in the web UI, or run: /usr/local/etc/rc.d/amneziawg start"

exit 0
